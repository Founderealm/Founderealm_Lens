# The launcher, the hook and the VS Code extension's entry point are plumbing. Founderealm
# Lens itself is a compiled binary from this repository's releases, which GitHub's language
# count does not see.
server/lens linguist-detectable=false
server/lens.cmd linguist-detectable=false
hooks/door.sh linguist-detectable=false
extension.js linguist-detectable=false

# The Windows launcher is a batch file, which cmd.exe reads reliably only with CRLF line
# endings: they are committed as they are, and git never converts them.
*.cmd -text
