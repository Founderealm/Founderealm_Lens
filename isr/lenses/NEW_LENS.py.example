#!/usr/bin/env python3
"""Copy to a .py file; shutter discovers this contract automatically."""
import json
import os
from pathlib import Path

LENS = {
    'id': 'your_question',
    'requires': ['inventory.json'],
    'produces': ['your_answer.json'],
    'feeds': [],
    'evidence': 'describe the direct or derived evidence used',
    'trust_tier': 'local_extension',
}

ROOT = Path(os.environ['ISR_ROOT']).resolve()
OUT = ROOT / 'isr'

def main():
    inventory = json.loads((OUT / 'inventory.json').read_text(encoding='utf-8'))
    (OUT / 'your_answer.json').write_text(json.dumps({'files_seen': len(inventory['files'])}) + '\n', encoding='utf-8')

if __name__ == '__main__':
    main()
